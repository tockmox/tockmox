#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Fake kubectl for tests/installer/bootstrap-secrets-tests.sh. Emulates just the
# calls bootstrap-secrets.sh makes, against a directory standing in for a
# cluster ($FAKE_STATE/cluster). Records every invocation's ARGUMENTS (never
# stdin) in $FAKE_STATE/calls.log. An unhandled call fails loudly: a shim that
# answers everything would let the script call anything and still pass.
S="${FAKE_STATE:?FAKE_STATE not set}"; C="$S/cluster"
mkdir -p "$C/ns" "$C/keys"; [ -e "$C/ns/kube-system" ] || : > "$C/ns/kube-system"
printf 'kubectl %s\n' "$*" >> "$S/calls.log"
args=("$@"); ns=""; rest=(); i=0
while [ "$i" -lt "${#args[@]}" ]; do
  case "${args[$i]}" in
    --context)         i=$((i + 2)) ;;
    -n|--namespace)    ns="${args[$((i + 1))]}"; i=$((i + 2)) ;;
    *)                 rest+=("${args[$i]}"); i=$((i + 1)) ;;
  esac
done
ctrl_ns=""; ctrl_name=""
ctrl_flag=""
[ -e "$C/controller" ] && read -r ctrl_ns ctrl_name ctrl_flag < "$C/controller"
has() { case " ${rest[*]} " in *" $1 "*) return 0 ;; esac; return 1; }
tmpl() { local a; for a in "${rest[@]}"; do case "$a" in *go-template*) return 0 ;; esac; done; return 1; }
keyfile_value() { sed -n "s/^$2=//p" "$1"; }

case "${rest[0]:-} ${rest[1]:-}" in
  "config current-context") echo "${FAKE_CONTEXT:-lab-test}"; exit 0 ;;
  "config view")            echo "https://192.0.2.10:6443"; exit 0 ;;
  "get namespace")
      if [ -n "${rest[2]:-}" ]; then [ -e "$C/ns/${rest[2]}" ]; exit $?; fi
      exit 0 ;;
  "create namespace") : > "$C/ns/${rest[2]}"; exit 0 ;;
  "get crd")  [ -n "$ctrl_name" ]; exit $? ;;
  "get deploy")
      if has -A; then
        # By label (the chart labels it; ctrl_flag "unlabeled" models the
        # upstream release YAML, which does not) or, without -l, listing every
        # Deployment with its image, as the script's second net does.
        if [ -n "$ctrl_name" ]; then
          if has -l; then [ "$ctrl_flag" = "unlabeled" ] || printf '%s %s\n' "$ctrl_ns" "$ctrl_name"
          else printf '%s %s docker.io/bitnami/sealed-secrets-controller:0.40.0\n' "$ctrl_ns" "$ctrl_name"; fi
        fi
        has -l || printf 'kube-system coredns rancher/mirrored-coredns-coredns:1.10.1\n'
        exit 0
      fi
      [ "$ns" = "$ctrl_ns" ] && [ "${rest[2]:-}" = "$ctrl_name" ] && [ -n "$ctrl_name" ] || exit 1
      case " ${rest[*]} " in *jsonpath*) echo "docker.io/bitnami/sealed-secrets-controller:0.40.0" ;; esac
      exit 0 ;;
  "get secret")
      d="$C/keys/$ns"
      if has -A; then
        for kd in "$C/keys"/*; do [ -d "$kd" ] && ls "$kd"/* >/dev/null 2>&1 && basename "$kd"; done
        exit 0
      fi
      if tmpl; then
        [ -d "$d" ] || exit 0
        for f in "$d"/*; do
          [ -e "$f" ] || continue
          printf -- '---\napiVersion: v1\nkind: Secret\nmetadata:\n  name: %s\n  labels:\n    sealedsecrets.bitnami.com/sealed-secrets-key: active\ntype: kubernetes.io/tls\ndata:\n  tls.crt: %s\n  tls.key: %s\n' \
            "$(basename "$f")" "$(keyfile_value "$f" crt)" "$(keyfile_value "$f" key)"
        done
        exit 0
      fi
      # -o name
      [ -d "$d" ] && for f in "$d"/*; do [ -e "$f" ] && echo "secret/$(basename "$f")"; done
      exit 0 ;;
  "create -f")
      # stdin: one or more Secret documents. Store name + tls.crt + tls.key.
      mkdir -p "$C/keys/$ns"
      awk -v dir="$C/keys/$ns" '
        /^---/ {name=""; crt=""; key=""; next}
        /^  name:/ && name=="" {name=$2}
        /^  tls.crt:/ {crt=$2}
        /^  tls.key:/ {key=$2}
        {if (name!="" && crt!="" && key!="") {f=dir "/" name; print "crt=" crt > f; print "key=" key >> f; close(f); print "secret/" name; name=""; crt=""; key=""}}
      '
      exit 0 ;;
esac
echo "fake kubectl: unhandled: $*" >&2
exit 1
