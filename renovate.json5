{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Dependency automation for the Tockmox OSS repo.
  //
  // What lives here and therefore what Renovate manages:
  //   .github/workflows/**   GitHub Actions refs + the tool-version env pins
  //   charts/*/Chart.yaml    Helm chart dependencies
  //   charts/*/templates/**  container image references
  //
  // There is no apps/ or infrastructure/ tree here ... that layout belongs to
  // the site/overlay repos, not the product.

  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled",
    // Pin workflow actions to commit SHAs. Supply-chain hygiene, and it also
    // resolves the Node 20 deprecation warnings by keeping refs current.
    "helpers:pinGitHubActionDigests",
  ],

  // Name the branches rather than lean on the repository default.
  // RELEASING.md "Orientation": `main` is the development trunk and
  // `release-X.Y` branches are cut from it. The CURRENT release line is a
  // target too, by exact name: once main moves to the next minor (caps lifted,
  // charts changed) its dependency commits stop applying to the line, so the
  // line gets its own PRs under the stricter rules at the END of packageRules
  // (patch opens, minor waits for a dashboard tick, major never, 7-day wait).
  // Exact name, not a pattern: a pattern would keep feeding an ended line,
  // against SECURITY.md. The name flips to the new line at the next minor's
  // final tag (RELEASING.md "The patch train", checklist). Merging to the line
  // stays a human act; Renovate only opens the PRs.
  baseBranchPatterns: ["main", "release-0.8"],

  timezone: "America/Chicago",

  // PRs open without a dashboard tick unless a rule below says otherwise
  // (majors do). Stated explicitly so an inherited default cannot hold every
  // branch under "Pending Approval".
  dependencyDashboardApproval: false,

  // One weekly batch rather than a trickle. Security PRs bypass this via
  // vulnerabilityAlerts below.
  // NOTE: `schedule` gates BRANCH CREATION, not scanning. Outside the window a
  // scan recomputes everything and writes nothing, parking items under
  // "Awaiting Schedule". Keep the window wide: a narrow one can be missed
  // entirely by the hosted scan cadence, silently rolling the whole batch over.
  schedule: ["before 9am on monday"],

  // Outside the window, leave existing branches alone as well: a PR's head
  // must not move after it has been approved for a patch train.
  updateNotScheduled: false,

  // Let upstreams eat their own day-0 regressions (non-security only).
  minimumReleaseAge: "3 days",

  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  labels: ["renovate"],

  // .github/workflows/renovate-regen.yaml adds one commit to a Renovate branch
  // whose chart bump changed images.txt or sbom.cdx.json. Renovate treats any
  // commit by another author as a human edit and stops rebasing and updating
  // that branch; listing the regen App here keeps the branch Renovate's. A
  // later update rebuilds the branch without the commit, and the workflow adds
  // it again on that push.
  gitIgnoredAuthors: ["345119929+tockmox-regen[bot]@users.noreply.github.com"],

  // Image refs inside chart templates. Anchored at ^charts/ deliberately:
  // a loose (^|/) form matches mid-path and can "update" a frozen test fixture.
  kubernetes: {
    managerFilePatterns: ["/^charts/.+\\.ya?ml$/"],
  },

  // bootstrap/ is documentation about generated artefacts, and any
  // targetRevision in it is a self-reference to a Tockmox release. Renovate
  // must not bump those: release tagging is a human act tied to the
  // deploy-proof gate.
  ignorePaths: ["bootstrap/**"],

  customManagers: [
    // CI tool pins live as env vars in ci.yaml so they are visible and
    // updatable. Without these managers those versions rot silently.
    {
      customType: "regex",
      description: "CI tool pin: helm",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.ya?ml$/"],
      matchStrings: ["HELM_VERSION:\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "helm/helm",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "CI tool pin: kubeconform",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.ya?ml$/"],
      matchStrings: ["KUBECONFORM_VERSION:\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "yannh/kubeconform",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "CI tool pin: gitleaks",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.ya?ml$/"],
      matchStrings: ["GITLEAKS_VERSION:\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "gitleaks/gitleaks",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "CI tool pin: shellcheck (advisory job; SHELLCHECK_SHA256 must be re-measured in the same PR)",
      managerFilePatterns: ["/^\\.github/workflows/check-all\\.ya?ml$/"],
      matchStrings: ["SHELLCHECK_VERSION:\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "koalaman/shellcheck",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "busybox wait-for-ca init container (registry threaded through tpl)",
      managerFilePatterns: ["/^charts/tockmox-devops/values\\.yaml$/"],
      matchStrings: ["/library/busybox:(?<currentValue>[0-9][^'\"\\s]*)"],
      depNameTemplate: "busybox",
      datasourceTemplate: "docker",
    },
  ],

  packageRules: [
    {
      // Majors on platform charts carry breaking-change risk and want a
      // deliberate window, not an auto-opened PR. Surface on the dashboard.
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // Postgres major is a deliberate, runbook-driven CNPG migration. Hold
      // majors entirely; patch and minor within a major are fine.
      // docker.io/library/postgres is the SAME image spelled in full, which is
      // how tockmox-identity's databaseBackup.postgresImage names it; Renovate
      // matches the name as written, so "postgres" alone let a 17 -> 18 bump of
      // that pg_dump client through while the server it dumps stays on 17
      // (TM-1010, 2026-10-11: dropped from the sweep).
      matchDatasources: ["docker"],
      matchPackageNames: ["postgres", "docker.io/library/postgres", "ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // Low-risk, high-frequency. One grouped PR instead of a dozen.
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      // These move in lockstep upstream, usually the same config-reloader bump.
      // Activates once tockmox-exporters declares them as chart dependencies.
      matchDatasources: ["helm"],
      matchPackageNames: [
        "prometheus-blackbox-exporter",
        "prometheus-snmp-exporter",
        "prometheus-smartctl-exporter",
      ],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "prometheus exporter charts",
    },
    {
      // tockmox-devops threads global.imageRegistry into the busybox init
      // container through tpl, so the helm-values manager reads a depName
      // with a template in it and the lookup fails on every run. Skip the
      // templated name here; the customManager above tracks the tag.
      matchPackageNames: ["/\\{\\{/"],
      enabled: false,
    },
    {
      // One PR for every patch and minor update instead of one each: a
      // dozen PRs a week each needing a merge was the cost, and several
      // touch the same Chart.lock, so merging them one at a time conflicts.
      // LAST on purpose: packageRules apply in order, so this group name
      // overrides the github-actions and exporter groups above for patch and
      // minor updates. Majors and security updates still arrive alone.
      // A chart bump in the group changes sbom.cdx.json and images.txt;
      // renovate-regen.yaml regenerates and commits both on the branch.
      matchUpdateTypes: ["minor", "patch"],
      groupName: "non-major dependencies",
      groupSlug: "non-major",
      // Stated, not inherited: these open as PRs without a dashboard tick.
      // Only majors wait for approval (the rule near the top).
      dependencyDashboardApproval: false,
    },
    {
      // THE AI PLANE TAKES EVERY RELEASE AS IT LANDS (maintainer ruling,
      // 2026-10-17). Open WebUI and LiteLLM ship several releases a week and
      // their fixes matter (spend accounting, access checks), so no 3-day soak
      // and no Monday window: a PR opens as soon as a stable release is out.
      // AFTER the non-major group on purpose, so this group name wins for
      // these packages. Both Open WebUI pins (the image tag and the
      // trust-bundle initContainer) are the same package, so they land in one
      // PR, which preflight requires. Majors still wait for dashboard approval
      // (the rule near the top), and prereleases are never proposed while a
      // stable version is current. renovate-regen.yaml regenerates images.txt
      // and the SBOM on the branch, so these PRs need no hand edit.
      matchPackageNames: [
        "ghcr.io/open-webui/open-webui",
        "open-webui",
        "ghcr.io/berriai/litellm-database",
        "litellm-helm",
        "ghcr.io/berriai/litellm-helm",
      ],
      minimumReleaseAge: null,
      schedule: ["at any time"],
      groupName: "AI plane (Open WebUI, LiteLLM)",
      groupSlug: "ai-plane",
      dependencyDashboardApproval: false,
    },

    // THE RELEASE LINE. Everything from here down is scoped to the branch in
    // baseBranchPatterns and applies only there. LAST on purpose: packageRules
    // are last-wins, so these override the rules above for PRs against the
    // line: the non-major group's no-tick, the AI plane's no-soak and "at any
    // time", all of it. The comments above describe main. A patch release is
    // cut from the line by the patch train (RELEASING.md), so what lands here
    // is what ships to every existing operator.
    {
      // Seven days for everything, the AI plane included: main dogfoods the
      // day-0 releases, the line does not. Security alerts keep the exemption
      // in vulnerabilityAlerts below.
      matchBaseBranches: ["release-0.8"],
      minimumReleaseAge: "7 days",
    },
    {
      // Patch updates open on their own, in one PR per batch.
      matchBaseBranches: ["release-0.8"],
      matchUpdateTypes: ["patch"],
      groupName: "release line patch updates",
      groupSlug: "release-patch",
      dependencyDashboardApproval: false,
    },
    {
      // Minor updates wait for a dashboard tick; the tick is the nomination
      // for the next train. Their own group, so an unticked minor never holds
      // a patch batch back.
      matchBaseBranches: ["release-0.8"],
      matchUpdateTypes: ["minor"],
      groupName: "release line minor updates",
      groupSlug: "release-minor",
      dependencyDashboardApproval: true,
    },
    {
      // No majors on a release line, ever. Main takes them under the rule near
      // the top; they reach operators with the next minor.
      matchBaseBranches: ["release-0.8"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // Workflow pins stay off the line: a change under .github/workflows
      // needs the `workflows` permission the regen App does not have, and a
      // CI change is not something a patch carries.
      matchBaseBranches: ["release-0.8"],
      matchManagers: ["github-actions"],
      enabled: false,
    },
    {
      // traefik 42 is a major and Python 3.15 is a new runtime under the
      // tockmox-ui and posture-probe images; neither belongs in a patch.
      // allowedVersions keeps them off the line's PR queue entirely instead of
      // relying on nobody ticking a dashboard box (traefik 42 was listed under
      // pending status checks despite the majors rule above). Scoped to the
      // line only: main is the next minor's cycle and takes them now.
      matchBaseBranches: ["release-0.8"],
      matchDatasources: ["helm"],
      matchPackageNames: ["traefik"],
      allowedVersions: "<42.0.0",
    },
    {
      matchBaseBranches: ["release-0.8"],
      matchDatasources: ["docker"],
      matchPackageNames: ["python"],
      allowedVersions: "<3.15",
    },
  ],

  // Security fixes jump the queue: no schedule, no release-age wait.
  vulnerabilityAlerts: {
    labels: ["renovate", "security"],
    schedule: ["at any time"],
    minimumReleaseAge: null,
  },
  osvVulnerabilityAlerts: true,
}
