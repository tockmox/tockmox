            "uid": "${datasource}"
          },
          "expr": "sum by (severity) (ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|TockmoxHeartbeat|InfoInhibitor\", severity=~\"critical|warning\"}) or label_replace(vector(0), \"severity\", \"warning\", \"\", \"\") or label_replace(vector(0), \"severity\", \"critical\", \"\", \"\")",
          "refId": "A",
          "legendFormat": "{{severity}}",
          "interval": "2h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "noValue": "no data",
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "spanNulls": false,
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
