              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "noValue": "no data",
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "spanNulls": false,
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
