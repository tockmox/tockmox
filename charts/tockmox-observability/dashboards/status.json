{
  "uid": "tockmox-status",
  "title": "Tockmox / Status",
  "description": "The trends the Tockmox UI draws on Status, AI and Platform, from the same expressions (tockmox-ui/app/panels.yaml). Generated by tools/gen-dashboard-status.py; do not edit.",
  "tags": [
    "tockmox",
    "product",
    "tier-l1",
    "ui"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "tockmox"
      ],
      "targetBlank": false,
      "title": "Tockmox dashboards",
      "type": "dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "label": "Data source",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 15,
      "type": "row",
      "title": "Status: the last 24 hours",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Alerts firing",
      "description": "Alerts firing over the last 24 hours, by severity, heartbeats left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (severity) (ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|TockmoxHeartbeat|InfoInhibitor\", severity=~\"critical|warning\"}) or label_replace(vector(0), \"severity\", \"warning\", \"\", \"\") or label_replace(vector(0), \"severity\", \"critical\", \"\", \"\")",
          "refId": "A",
          "legendFormat": "{{severity}}",
          "interval": "15m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "noValue": "no data",
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "spanNulls": false,
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Scrape targets up",
      "description": "The share of Prometheus scrape targets answering, over the last 24 hours.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * avg(up)",
          "refId": "A",
          "legendFormat": "Scrape targets up",
          "interval": "15m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "noValue": "no data",
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "spanNulls": false,
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
