{
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "tockmox"
      ],
      "targetBlank": false,
      "title": "Tockmox dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "datasource": null,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "<!--tockmox-logo--><div style=\"display:flex;align-items:center;height:100%;padding:0 16px;box-sizing:border-box;border-bottom:2px solid #2FB44A;\"><img src=\"data:image/svg+xml;base64,\" alt=\"Tockmox\" style=\"height:44px;width:auto;\" /><span style=\"margin-left:20px;color:#9AA5A0;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-family:'Nunito Sans',system-ui,sans-serif;\">Magic is just well-documented engineering</span></div>",
        "mode": "html"
      },
      "pluginVersion": "11.0.0",
      "title": "",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(kube_persistentvolumeclaim_status_phase{phase=\"Pending\"}) OR on() vector(0)",
          "refId": "A"
        }
      ],
      "title": "Pending PVCs (bind failures look like nothing)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 2
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(kube_storageclass_info) OR on() vector(0)",
          "refId": "A"
        }
      ],
      "title": "StorageClasses on the cluster",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 2
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (volume) (avg_over_time(longhorn_volume_robustness{state=\"faulted\"}[30m])) > 0.05) OR on() vector(0)",
          "refId": "A"
        }
      ],
      "title": "Faulted Longhorn volumes (duty cycle)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 2
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (volume) (avg_over_time(longhorn_volume_state{state=\"attaching\"}[15m])) > 0.5) OR on() vector(0)",
          "refId": "A"
        }
      ],
      "title": "Volumes stuck attaching (duty cycle)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(PersistentVolumeClaim|persistentvolumeclaim)$"
            },
            "properties": [
              {
                "id": "custom.wrapText",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Namespace|namespace)$"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(StorageClass|storageclass)$"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.wrapText",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(VolumeName|volumename)$"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 380
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_persistentvolumeclaim_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Every PVC and the class it landed on (the contract, observed)",
      "type": "table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "service": true,
              "pod": true,
              "uid": true,
              "Time": true,
              "Value": true,
              "volumemode": true
            },
            "indexByName": {
              "namespace": 0,
              "persistentvolumeclaim": 1,
              "storageclass": 2,
              "volumename": 3
            },
            "renameByName": {
              "namespace": "Namespace",
              "persistentvolumeclaim": "PersistentVolumeClaim",
              "storageclass": "StorageClass",
              "volumename": "VolumeName"
            }
          }
        }
      ],
      "description": "kube_persistentvolumeclaim_info, reduced to the three fields the title promises. Without the transformation this renders __name__, container, endpoint and instance ... metric plumbing rather than the contract, which is what shipped until 2026-09-12."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (state) (longhorn_volume_robustness)",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "title": "Longhorn volume robustness by state",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "platform",
    "tockmox"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "label": "Data source",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "title": "Tockmox / Storage Contract",
  "uid": "tockmox-storage-contract"
}
